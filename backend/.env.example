# ════════════════════════════════════════════════
#  Discord Server Builder Pro — Backend .env
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════

# ── Stripe ──────────────────────────────────────
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Found at: https://dashboard.stripe.com/webhooks  (after you create the webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe products
# Found at: https://dashboard.stripe.com/products  → click a product → copy "Price ID"
STRIPE_PRICE_DEVELOPER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...

# ── Supabase ─────────────────────────────────────
# Found at: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Server ───────────────────────────────────────
# Your deployed URL (Railway gives you one automatically)
# Used for Stripe success/cancel redirect pages
APP_URL=https://YOUR-APP.up.railway.app

PORT=3001
